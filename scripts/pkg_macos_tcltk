#!/bin/sh
#
# Assemble ZangbandTK.app from a cmake build of the Tcl/Tk front end.
#
# Use in the root directory of the game, like so:
#    scripts/pkg_macos_tcltk <build-directory> [output-directory]
#
# The build directory is whatever was configured with SUPPORT_TCL_FRONTEND=ON.
# The bundle goes to ~/Applications unless an output directory is given: the
# per-user Applications folder, where Spotlight and Launchpad find it, and
# building it straight there means there is only ever one of it.  Two copies
# both claim org.zangbandtk.zangbandtkgui, and then Launch Services decides
# which one your double-click starts; see the warning at the end.  Not the
# Desktop, where it used to go: with iCloud's Desktop and Documents on, every
# build was uploaded, and the file provider's handling of it cost a blank icon,
# an unsigned bundle, a quarantine mark and a conflict copy in one afternoon.
#
# This is a second application, not a replacement for the Cocoa one.  See
# decision 14 in .claude/plans/phase3-tcl-tk-frontend.md: Zangband.app is a
# different play experience and stays, so this one has its own name and its own
# bundle identifier, and src/Makefile.osx is not touched by any of it.
#
# Three things have to be true for the bundle to run anywhere but this machine,
# and each has caught somebody out before:
#
#   1. The game's data has to be inside it.  A self-contained build compiles in
#      DEFAULT_LIB_PATH="./lib/", and a bundle launched from the Finder has "/"
#      for a working directory, so "./lib" is the root of the disk.  main.c
#      detects the bundle and uses Contents/Resources/lib instead; this script
#      is what puts the data there.
#
#   2. Tcl and Tk have to find their own script libraries.  They are not
#      optional extras -- an interpreter without init.tcl cannot evaluate
#      anything -- so Contents/Resources/tcltk carries both trees.
#
#   3. The two dylibs have to travel with it, and the executable has to be able
#      to find them once they have moved.  They already carry an @rpath install
#      name -- scripts/build-tcltk sets that at link time, because zipfs appends
#      an archive to each dylib and install_name_tool will not touch a file with
#      data past __LINKEDIT -- so all that is needed here is to swap the
#      development rpath on our own executable for one relative to the bundle.
#      The check at the end is what proves it: any remaining reference to the
#      build tree is a bundle that would die on someone else's Mac with a dyld
#      error and no explanation.
set -o errexit

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
	sed -n -e '3,16p' "$0" | sed -e 's/^# \{0,1\}//'
	exit 1
fi

ROOT=$(cd "$(dirname "$0")/.." && pwd)
BUILD=$1
if [ $# -eq 2 ]; then
	OUT=$2
else
	OUT=$HOME/Applications
	mkdir -p "$OUT"
fi

# ZangbandTK, since this is the one with Tk in it (DEC-143); it was
# ZangbandTKGUI.app until then, and never shipped under that name.  The
# identifier is the one it had, deliberately, and must not follow the name:
# org.zangbandtk.zangbandtk is the Cocoa application's, which was called
# ZangbandTK.app up to 3.128.0 and is still installed under that name on the
# Macs of everyone who downloaded it.  Two bundles claiming one identifier is
# the fight decision 14 is there to prevent.
NAME=ZangbandTK
IDENT=org.zangbandtk.zangbandtkgui
APP=$OUT/$NAME.app
EXE=$BUILD/game/angband

if [ ! -x "$EXE" ]; then
	echo "No executable at $EXE." >&2
	echo "Configure with -DSUPPORT_TCL_FRONTEND=ON and build first." >&2
	exit 1
fi

# Refuse a build that has no Tcl in it rather than producing a bundle that
# looks right and cannot start.
if ! otool -L "$EXE" | grep -q libtcl9tk; then
	echo "$EXE does not link Tk." >&2
	echo "That build was configured without SUPPORT_TCL_FRONTEND." >&2
	exit 1
fi

# Where the toolchain came from, read off the executable rather than guessed,
# so this works for any TCLTK_PREFIX the build was pointed at.  It comes from
# the rpath and not from otool -L, because the libraries are referenced as
# @rpath/libtcl9.0.dylib and the rpath is the only place the real directory
# appears.
TCLTK_LIB=$(otool -l "$EXE" | awk '/LC_RPATH/{r=1} r&&/ path /{print $2; exit}')
if [ -z "$TCLTK_LIB" ]; then
	echo "$EXE has no rpath, so the Tcl/Tk it was built against cannot be" >&2
	echo "located.  Rebuild with a current TCL_Frontend.cmake." >&2
	exit 1
fi
TCLTK_PREFIX=$(dirname "$TCLTK_LIB")
if [ ! -d "$TCLTK_LIB/tcl9.0" ] || [ ! -d "$TCLTK_LIB/tk9.0" ]; then
	echo "No Tcl/Tk script libraries under $TCLTK_LIB." >&2
	exit 1
fi

VERSION=$(sed -n 's/^#define VERSION_STRING[[:space:]]*"\(.*\)"/\1/p' "$ROOT/src/buildid.h")
BASE=$(sed -n 's/^#define BASE_VERSION_STRING[[:space:]]*"\(.*\)"/\1/p' "$ROOT/src/buildid.h")
COPYRIGHT="ZangbandTK $VERSION, based on Angband $BASE. (c) 1987-2026 Angband contributors, (c) 1997-2005 Zangband DevTeam, (c) 2026 ZangbandTK contributors"

echo "==> $APP  ($VERSION)"

# Assembled beside where it goes, under a name the Finder does not treat as a
# bundle, and renamed into place only once it is whole and checked.
#
# Built in place, the bundle is watched being made: a folder the Finder shows,
# the Desktop above all, is the Finder's, and with iCloud's Desktop and
# Documents on it is the file provider's too.
# Both look at a new .app the moment its folder appears, before it has a plist
# or an icon, so the Finder caches a blank icon for it, and the Finder
# information they attach makes codesign refuse the bundle outright as
# "detritus" -- which left it unsigned, quietly, on every build to the Desktop.
# A rename within one directory is one step, so neither ever sees it half done,
# and a build that fails a check leaves the previous app where it was.
FINAL=$APP
APP=$OUT/.$NAME.app.partial
trap 'rm -rf "$OUT/.$NAME.app.partial"' EXIT
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources" "$APP/Contents/Frameworks"

# 1. The executable and the game data.
install -m 755 "$EXE" "$APP/Contents/MacOS/$NAME"
for d in gamedata customize screens help tiles sounds icons tcl; do
	if [ -d "$ROOT/lib/$d" ]; then
		mkdir -p "$APP/Contents/Resources/lib/$d"
		# -R so tiles/ and sounds/ bring their subdirectories with them.
		cp -R "$ROOT/lib/$d/" "$APP/Contents/Resources/lib/$d/"
	fi
done

# The icon: the same file Zangband.app ships, under the name Info.plist.in
# gives as CFBundleIconFile.
install -m 644 "$ROOT/src/cocoa/Zangband_Icons.icns" \
	"$APP/Contents/Resources/$NAME.icns"

# 2. Tcl's and Tk's script libraries.
mkdir -p "$APP/Contents/Resources/tcltk"
cp -R "$TCLTK_LIB/tcl9.0" "$APP/Contents/Resources/tcltk/tcl9.0"
cp -R "$TCLTK_LIB/tk9.0" "$APP/Contents/Resources/tcltk/tk9.0"
# tcl9/ holds the modules -- http, msgcat, platform, tcltest -- which init.tcl
# puts on the module path.  Missing, `package require` fails at runtime only.
if [ -d "$TCLTK_LIB/tcl9" ]; then
	cp -R "$TCLTK_LIB/tcl9" "$APP/Contents/Resources/tcltk/tcl9"
fi

# 3. The dylibs, cut back to their Mach-O image, and then the executable's
#    rpath.
#
#    scripts/build-tcltk leaves zipfs on, so each dylib has a zip of its own
#    script library appended after __LINKEDIT -- 1.2 MB in Tcl's, 0.3 MB in
#    Tk's.  codesign refuses any binary with data past its end ("main
#    executable failed strict validation", said of the dylib), and that left
#    every bundle unsigned.  In here the archives are redundant: the same
#    libraries are in Contents/Resources/tcltk as ordinary files, which is
#    where main-tcl.c points TCL_LIBRARY and TK_LIBRARY.  So the copies lose
#    them and the toolchain keeps its zipfs.  The image itself is untouched,
#    which is why nothing here needs install_name_tool on a dylib.
for lib in libtcl9.0.dylib libtcl9tk9.0.dylib; do
	END=$(otool -l "$TCLTK_LIB/$lib" | awk '
		/segname __LINKEDIT/ { seg = 1 }
		seg && /fileoff/ { off = $2 }
		seg && /filesize/ { print off + $2; exit }')
	if [ -z "$END" ]; then
		echo "$TCLTK_LIB/$lib has no __LINKEDIT segment." >&2
		exit 1
	fi
	head -c "$END" "$TCLTK_LIB/$lib" > "$APP/Contents/Frameworks/$lib"
	chmod 644 "$APP/Contents/Frameworks/$lib"
done
install_name_tool -delete_rpath "$TCLTK_LIB" "$APP/Contents/MacOS/$NAME" 2>/dev/null || true
install_name_tool -add_rpath "@executable_path/../Frameworks" \
	"$APP/Contents/MacOS/$NAME"

# 4. The plist.
#
# Both dollars in each placeholder are backslash-escaped, and that is not
# decoration: in a basic regular expression a trailing `$` is an end-of-line
# anchor, so `s|$VERSION$|...|` matches only a line ending in the text
# "$VERSION" and silently substitutes nothing.  The result is a plist full of
# unreplaced placeholders, and the Finder reports that as "the application
# cannot be opened because its executable is missing", which points nowhere
# near the cause.  src/Makefile.osx escapes them for the same reason.
sed -e 's|\$EXECUTABLE\$|'"$NAME"'|g' \
	-e 's|\$NAME\$|'"$NAME"'|g' \
	-e 's|\$BUNDLE_IDENTIFIER\$|'"$IDENT"'|g' \
	-e 's|\$VERSION\$|'"$VERSION"'|g' \
	-e 's|\$COPYRIGHT\$|'"$COPYRIGHT"'|g' \
	"$ROOT/src/tcl/Info.plist.in" > "$APP/Contents/Info.plist"

# 5. The licences: the game's, and those of Tcl and Tk, whose terms ask for
#    their notice in every copy.  Inside the bundle, so they go wherever the
#    application is dragged; dmg_macos_tcltk puts copies beside it as well.
#    The scan of Frameworks is the guard: a library put there without a
#    licence in licenses/ stops the build here.  Before the signature, which
#    seals Resources along with everything else.
cp "$ROOT/LICENSE.md" "$APP/Contents/Resources/LICENSE.md"
"$ROOT/scripts/third-party-notices" -n "$NAME" -s "$APP/Contents/Frameworks" \
	"$APP/Contents/Resources/THIRD-PARTY-LICENSES.txt"

# An ad-hoc signature, the same as the release gives Zangband.app: no
# Developer ID, but a bundle whose every piece is sealed, which is what
# Gatekeeper and codesign --verify ask of it.  Extended attributes first,
# because codesign refuses a bundle that carries any: whatever the copies
# above brought with them.  The dylibs before the bundle, since sealing the
# bundle records their signatures.  A failure stops the build: an unsigned or
# half-signed bundle is not one to hand anybody.
xattr -cr "$APP"
codesign --force --sign - "$APP/Contents/Frameworks/"*.dylib
codesign --force --sign - "$APP"
codesign --verify --strict --verbose=1 "$APP" || {
	echo "The bundle's signature does not verify." >&2
	exit 1
}

# The check that matters: nothing in the bundle may point back at the tree it
# was built in.
echo "==> Checking the bundle"
LEAKED=$(otool -L "$APP/Contents/MacOS/$NAME" "$APP/Contents/Frameworks/"*.dylib \
	| grep -E "$TCLTK_PREFIX|$BUILD" || true)
if [ -n "$LEAKED" ]; then
	echo "The bundle still references its build tree:" >&2
	echo "$LEAKED" >&2
	exit 1
fi
test -f "$APP/Contents/Resources/lib/gamedata/object.txt" || {
	echo "No game data in the bundle." >&2
	exit 1
}
test -f "$APP/Contents/Resources/lib/tcl/main.tcl" || {
	echo "No front-end scripts in the bundle -- it would start with no window." >&2
	exit 1
}
test -f "$APP/Contents/Resources/tcltk/tcl9.0/init.tcl" || {
	echo "No Tcl script library in the bundle." >&2
	exit 1
}
ICON=$(/usr/libexec/PlistBuddy -c "Print :CFBundleIconFile" \
	"$APP/Contents/Info.plist" 2>/dev/null || true)
test -n "$ICON" && test -f "$APP/Contents/Resources/$ICON" || {
	echo "The plist names an icon the bundle does not have: '$ICON'." >&2
	exit 1
}
plutil -lint "$APP/Contents/Info.plist" > /dev/null
# A plist that still has placeholders in it is syntactically valid, so plutil is
# happy and the Finder is not.  Check for them by name.
if grep -q '\$[A-Z_]*\$' "$APP/Contents/Info.plist"; then
	echo "Info.plist still has unsubstituted placeholders:" >&2
	grep -o '\$[A-Z_]*\$' "$APP/Contents/Info.plist" | sort -u >&2
	exit 1
fi
test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' \
	"$APP/Contents/Info.plist")" = "$NAME" || {
	echo "CFBundleExecutable does not name the executable that is there." >&2
	exit 1
}
# Every binary must run on the macOS the plist promises.  The compiler's
# default is the macOS it ran on, which made a bundle that would not open on
# anything older than the machine that built it.
MIN_OS=$(/usr/libexec/PlistBuddy -c "Print :LSMinimumSystemVersion" \
	"$APP/Contents/Info.plist")
for bin in "$APP/Contents/MacOS/$NAME" "$APP/Contents/Frameworks/"*.dylib; do
	NEEDS=$(otool -l "$bin" | awk '
		/LC_BUILD_VERSION/ { b = 1 }
		b && /minos/ { print $2; exit }')
	if [ -n "$NEEDS" ] && [ "$(printf '%s\n%s\n' "$NEEDS" "$MIN_OS" \
			| sort -V | tail -1)" != "$MIN_OS" ]; then
		echo "$(basename "$bin") needs macOS $NEEDS; the plist promises $MIN_OS." >&2
		echo "Rebuild Tcl and Tk (scripts/build-tcl-app does) and the game." >&2
		exit 1
	fi
done

# Whole and checked, so into place.
rm -rf "$FINAL"
mv "$APP" "$FINAL"
APP=$FINAL

# Built here, so not a download, and it must not be marked as one.  A bundle
# that turned up on the Desktop carrying com.apple.quarantine -- with no agent
# and no date, so from nothing that downloaded it -- was refused by Gatekeeper
# on opening ("Apple could not verify ... is free of malware"), which applies
# to a quarantined bundle the notarisation a local build can never have.
xattr -dr com.apple.quarantine "$APP" 2>/dev/null || true

# Two bundles with one identifier is the trap this project already wrote down
# and then walked into: Launch Services picks between them, so double-clicking
# one can start the other, and a copy left in a scratch directory quietly wins
# over the one in Applications.  It is not an error -- you may well have an old
# build lying about deliberately -- but it must not be silent.
#
# Found by identifier, not by name.  The name was the test until DEC-143, and
# then it pointed the wrong way twice: an old ZangbandTKGUI.app has this
# identifier and another name, and an old ZangbandTK.app -- the Cocoa
# application, as it was called up to 3.128.0 -- has this name and another
# identifier.  The dump gives each bundle's path a few lines before its
# identifier, with Launch Services' own handle, " (0x...)", after the path.
LSREG=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
if [ -x "$LSREG" ]; then
	OTHERS=$("$LSREG" -dump 2>/dev/null \
		| awk -v id="$IDENT" '
			/^path:/ { sub(/^path: */, ""); sub(/ \(0x[0-9a-f]+\)$/, ""); path = $0 }
			/^identifier:/ && $2 == id { print path }' \
		| sort -u | grep -v -x -F "$APP" || true)
	if [ -n "$OTHERS" ]; then
		echo "    warning: other bundles are registered with $IDENT,"
		echo "    the same identifier, and the Finder may launch one of those:"
		echo "$OTHERS" | sed 's/^/      /'
		echo "    Remove them, or unregister with: $LSREG -u <path>"
	fi
	"$LSREG" -f "$APP" 2>/dev/null || true
fi

echo "==> Done.  open $APP"
