#!/bin/sh
#
# How far the borg actually gets (BRG-18).
#
# Best depth and character level over N turns, per class, from fixed seeds.
# This is the number that says whether the borg is verification of M8 to M10 or
# a crash harness: a borg parked at depth 2 exercises almost none of the
# mutations, the deeper realms' spells or the out-of-depth monsters that only
# appear further down.
#
# It is a script rather than a shell loop in somebody's notes because the same
# sweep was hand-rolled four times while chasing the depth stall, each time
# slightly differently, which makes runs incomparable. The output is one line
# per run plus a summary, so two runs can be diffed.
#
# Usage: scripts/borg-progress [-x exe] [-n turns] [-m minutes]
#                              [-c class[,class...]] [-b baseline] [seed...]
#
# -b compares the run against a committed baseline and fails if a number has
# dropped materially. That is the point of the nightly: deaths are not failures
# and neither are time caps, so without this the job is green while best depth
# halves.
#
# -m bounds each run by the clock as well as by turns, and the clock is the
# outer bound: a turn budget does not bound wall time, because a character at
# depth computes far more per turn than one at depth 1 and a wedged run
# consumes no turns at all while running for ever.
#
# Deaths are reported, not treated as failures -- the borg dies often at low
# level and that is ordinary play (see c_borg_status). The exit status is
# non-zero only for a crash, an abort or a wedge, which is what CI should care
# about.

exe=build-strict/game/angband
turns=40000
minutes=
baseline=
classes=Warrior

while [ $# -gt 0 ]; do
	case "$1" in
		-x) exe="$2"; shift 2 ;;
		-n) turns="$2"; shift 2 ;;
		-m) minutes="$2"; shift 2 ;;
		-b) baseline="$2"; shift 2 ;;
		-c) classes="$2"; shift 2 ;;
		--) shift; break ;;
		-*) echo "borg-progress: unknown option $1" >&2; exit 2 ;;
		*) break ;;
	esac
done

if [ $# -gt 0 ]; then seeds="$*"; else seeds="1 7 13 42 99 2026"; fi

# Seeds are numbers. Options only count before them, so `-b file` written after
# the seed list is silently swallowed as two more seeds -- which is how a run
# came to report a class playing seed "tests/borg/BASELINE". Checked rather than
# documented, because the failure looks like a strange result rather than a
# mistake in the command.
for seed in $seeds; do
	case "$seed" in
		''|*[!0-9]*)
			echo "borg-progress: '$seed' is not a seed." >&2
			echo "borg-progress: options go before the seeds." >&2
			exit 2 ;;
	esac
done

if [ ! -x "$exe" ]; then
	echo "borg-progress: no executable at $exe" >&2
	exit 2
fi

LANG=${LANG:-en_US.UTF-8}
export LANG
ZTK_HEADLESS=1
export ZTK_HEADLESS

# A step budget generous enough that the turn budget is what ends a run. Left
# finite on purpose: a wedged borg must fail rather than hang.
ZTK_BORG_STEPS=${ZTK_BORG_STEPS:-20000000}
export ZTK_BORG_STEPS

if [ -n "$minutes" ]; then
	ZTK_BORG_MINUTES="$minutes"
	export ZTK_BORG_MINUTES
fi

if [ -n "$minutes" ]; then
	echo "borg-progress: $turns turns or $minutes minutes, seeds [$seeds]"
else
	echo "borg-progress: $turns turns, seeds [$seeds]"
fi
printf '%-15s %6s %7s %7s %7s  %s\n' class seed turns depth clevel outcome

broken=0
runs=0
best_depth=0
best_level=0
# The machine, which turns out to be part of what is being measured.
#
# These runs are exact to the turn on one machine and are *not* portable across
# machines: the same seed, class and commit gave Warrior seed 13 a run of
# 280,358 turns to character level 13 on Darwin arm64 and 5,252 turns to level 1
# on Linux x86_64. The first baseline was taken locally and compared against CI,
# which made a red night look like a regression in the game when it was a
# difference of hardware. Recording the platform is what stops that repeating.
platform="$(uname -s) $(uname -m)"

best_depth_run=none
best_level_run=none
deaths=0
capped=0
learned_total=0
cast_total=0

for class in $(echo "$classes" | tr ',' ' '); do
	ZTK_HEADLESS_CLASS="$class"
	export ZTK_HEADLESS_CLASS

	for seed in $seeds; do
		runs=$(expr $runs + 1)

		out=$(printf 'borg-seed %s\nborg-run %s\nborg-status?\nborg-exercise?\nquit\n' \
			"$seed" "$turns" | "$exe" -mtest 2>&1)
		rc=$?
		line=$(printf '%s\n' "$out" | grep '^borg-status:')

		if [ $rc -ne 0 ] || [ -z "$line" ]; then
			broken=$(expr $broken + 1)
			printf '%-15s %6s %7s %7s %7s  BROKEN (exit %s)\n' \
				"$class" "$seed" "-" "-" "-" "$rc"
			printf '%s\n' "$out" | tail -6 | sed 's/^/    /'
			continue
		fi

		t=$(printf '%s\n' "$line" | sed -n 's/.*turn=\([0-9]*\).*/\1/p')
		d=$(printf '%s\n' "$line" | sed -n 's/.*maxdepth=\([0-9]*\).*/\1/p')
		l=$(printf '%s\n' "$line" | sed -n 's/.*clevel=\([0-9]*\).*/\1/p')
		r=$(printf '%s\n' "$line" | sed -n 's/.*result=\([a-z]*\).*/\1/p')

		if [ "$d" -gt "$best_depth" ] 2>/dev/null; then
			best_depth=$d; best_depth_run="$class seed $seed"
		fi
		if [ "$l" -gt "$best_level" ] 2>/dev/null; then
			best_level=$l; best_level_run="$class seed $seed"
		fi
		[ "$r" = "died" ] && deaths=$(expr $deaths + 1)
		[ "$r" = "capped" ] && capped=$(expr $capped + 1)

		printf '%-15s %6s %7s %7s %7s  %s\n' "$class" "$seed" "$t" "$d" "$l" "$r"

		# What the run exercised, which is the point of running it at all.
		# A borg that reaches depth 30 having cast nothing has verified
		# almost none of M8, M9 or M10, and the depth alone would hide that.
		ex=$(printf '%s\n' "$out" | grep '^borg-exercise:')
		if [ -n "$ex" ]; then
			printf '%s\n' "$ex" | sed 's/^borg-exercise: /    exercised: /'
			el=$(printf '%s\n' "$ex" | sed -n 's/.*learned=\([0-9]*\).*/\1/p')
			ec=$(printf '%s\n' "$ex" | sed -n 's/.*cast=\([0-9]*\).*/\1/p')
			learned_total=$(expr $learned_total + ${el:-0})
			cast_total=$(expr $cast_total + ${ec:-0})
		fi
	done
done

echo
echo "borg-progress: $runs runs, best depth $best_depth, best level $best_level,"
echo "borg-progress: $deaths died, $capped capped, $broken broken,"
echo "borg-progress: $learned_total spells learned, $cast_total cast"
echo "borg-progress: on $platform"

# Deaths and time caps are data. Only a crash, an abort or a wedge is a
# failure, and each of those has already printed its seed above.
[ $broken -gt 0 ] && exit $broken

[ -z "$baseline" ] && exit 0

if [ ! -f "$baseline" ]; then
	echo "borg-progress: no baseline at $baseline" >&2
	exit 2
fi

# A capped run stopped where the clock landed rather than where the borg did,
# and the clock depends on how busy the machine is. Every other run is exact --
# the same seed on the same build gives the same turn count every time -- so a
# comparison is only meaningful when nothing was capped, and saying that out
# loud beats quietly comparing numbers that cannot be compared.
if [ $capped -gt 0 ]; then
	echo
	echo "borg-progress: $capped run(s) hit the clock, so the numbers are not"
	echo "borg-progress: comparable and the baseline check is SKIPPED. Raise -m,"
	echo "borg-progress: or lower -n, until every run finishes on its own."
	exit 0
fi

want() {
	sed -n "s/^$1:[[:space:]]*\([0-9][0-9]*\).*/\1/p" "$baseline" | head -1
}
want_note() {
	sed -n "s/^$1:[[:space:]]*[0-9][0-9]*[[:space:]]*//p" "$baseline" | head -1
}

b_platform=$(sed -n 's/^platform:[[:space:]]*//p' "$baseline" | head -1)

if [ -n "$b_platform" ] && [ "$b_platform" != "$platform" ]; then
	echo
	echo "borg-progress: this is $platform; $baseline was taken on"
	echo "borg-progress: $b_platform. The runs are exact on one machine and"
	echo "borg-progress: not comparable between two, so the baseline check is"
	echo "borg-progress: SKIPPED. Compare a run against a baseline from the"
	echo "borg-progress: same platform, which for the nightly means taking the"
	echo "borg-progress: baseline from a nightly."
	exit 0
fi

b_depth=$(want best-depth)
b_level=$(want best-level)
b_learn=$(want spells-learned)
b_cast=$(want spells-cast)
b_runs=$(want runs)

regressed=0

# Thresholds, chosen and not inherited. For one build and one set of seeds
# these runs are exact to the turn, so nothing here is noise -- but any data
# change reshuffles the random stream and moves which seed happens to do well.
# Measured, the spread across three seeds is depth 1 to 7 and level 1 to 13, so
# a reshuffle can plausibly cost a couple. Three cannot be explained that way.
report() {
	echo
	echo "borg-progress: REGRESSION -- $1"
	echo "borg-progress:   was $2 ($4), now $3"
	echo "borg-progress:   reproduce: scripts/borg-progress -n $turns -c $classes $seeds"
	regressed=1
}

if [ -n "$b_depth" ] && [ $((b_depth - best_depth)) -ge 3 ]; then
	report "best depth fell by $((b_depth - best_depth))" \
		"$b_depth" "$best_depth by $best_depth_run" "$(want_note best-depth)"
fi
if [ -n "$b_level" ] && [ $((b_level - best_level)) -ge 4 ]; then
	report "best character level fell by $((b_level - best_level))" \
		"$b_level" "$best_level by $best_level_run" "$(want_note best-level)"
fi
if [ -n "$b_cast" ] && [ $((cast_total * 2)) -lt "$b_cast" ]; then
	report "spells cast less than halved" \
		"$b_cast" "$cast_total across $runs runs" "over ${b_runs:-?} runs"
fi
if [ -n "$b_learn" ] && [ $((learned_total * 2)) -lt "$b_learn" ]; then
	report "spells learned less than halved" \
		"$b_learn" "$learned_total across $runs runs" "over ${b_runs:-?} runs"
fi

if [ $regressed -eq 0 ]; then
	echo
	echo "borg-progress: against $baseline -- depth $best_depth/$b_depth," \
		"level $best_level/$b_level, learned $learned_total/$b_learn," \
		"cast $cast_total/$b_cast"
	echo "borg-progress: no material drop."
	exit 0
fi

echo
echo "borg-progress: if this is an improvement being measured the wrong way,"
echo "borg-progress: or a change that legitimately moved the numbers, update"
echo "borg-progress: $baseline and say why in the commit."
exit 1
