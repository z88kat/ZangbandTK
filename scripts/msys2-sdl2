#!/bin/sh
#
# Install SDL2 and SDL2_mixer into MSYS2's MINGW64 for ZangbandTK's Windows
# build: the packages it was last built with, not the ones MSYS2 has now.
#
# Use in an MSYS2 MINGW64 shell, like so:
#    scripts/msys2-sdl2
#
# MSYS2 replaced both in November 2026.  Its SDL2 is now sdl2-compat, an
# SDL2.dll that runs on SDL3 and loads SDL3.dll by name at run time rather
# than importing it.  scripts/pkg_win_tcltk bundles what the import tables
# name, so it would not see SDL3.dll, and the zip would ship without it.  Its
# SDL2_mixer was rebuilt to link FluidSynth and libgme, and FluidSynth brings
# GNU readline with it, which is GPL 3 and does not mix with the game's GPL 2,
# besides PortAudio, libsndfile and the GCC runtimes.
#
# So this installs the last builds before the change, SDL2 2.32.10-1 and
# SDL2_mixer 2.8.2-1, from MSYS2's own mirror.  pacman checks their
# signatures as it does any package's, and takes their dependencies from the
# current repository.  When the mirror drops them, this fails here rather than
# quietly.  The way on then is to build SDL2 from source, as scripts/build-sdl2
# does for Linux.
set -o errexit

MIRROR=https://repo.msys2.org/mingw/mingw64
pacman -U --noconfirm \
	"$MIRROR/mingw-w64-x86_64-SDL2-2.32.10-1-any.pkg.tar.zst" \
	"$MIRROR/mingw-w64-x86_64-SDL2_mixer-2.8.2-1-any.pkg.tar.zst"
pacman -Q mingw-w64-x86_64-SDL2 mingw-w64-x86_64-SDL2_mixer
