#!/bin/sh
#
# Build SDL2 and the libraries beside it that the game uses -- SDL2_image,
# SDL2_ttf and SDL2_mixer -- from their release tarballs, into a project-local
# prefix that the Linux AppImages and the Windows downloads link against and
# carry.
#
# Use in the root directory of the game, like so:
#    scripts/build-sdl2 [prefix]
#
# It runs on Linux and under MSYS2's MINGW64 shell.  On Windows it builds SDL2
# and SDL2_mixer and leaves SDL2_image and SDL2_ttf out, because only the SDL2
# front end uses those and the Windows download the Tk workflow makes does not
# build it.  Everything else -- the codec choices, the checks at the end -- is
# the same on both, which is the point: one place decides what the game can
# decode, so the two platforms cannot drift apart.
#
# Why Windows builds its own rather than installing MSYS2's: in November 2026
# MSYS2 replaced SDL2 with sdl2-compat, an SDL2 that runs on SDL3, and rebuilt
# SDL2_mixer against five codec libraries.  The new SDL2_mixer links
# FluidSynth, FluidSynth links GNU readline, and readline is GPL 3, which a
# GPL 2 game cannot carry; pkg_win_tcltk's licence check would have stopped
# the zip.  The stop-gap was a script that pinned the last two packages from
# before that change, straight from MSYS2's mirror, and a pin lasts only as
# long as the mirror keeps them.  This is the answer that does not expire, and
# the pin is gone with it.
#
# The prefix defaults to sdl2/local; the tarballs and the object trees go in
# sdl2/ beside it, and all of it is gitignored.  Point cmake at the result with
# PKG_CONFIG_PATH=<prefix>/lib/pkgconfig.
#
# This is for the release's Linux builds, which are made on Ubuntu 18.04 so that
# they start on everything since (scripts/oldest-linux/Dockerfile).  18.04's own
# SDL is 2.0.8, from 2017: older than the SDL2 front end compiles against -- it
# handles SDL_WINDOWEVENT_ICCPROF_CHANGED, which is 2.0.18 -- and an AppImage
# carries whatever it was built with to every player who runs it.
#
# Each library decodes its formats itself rather than through others: PNG with
# stb_image, MP3, Ogg Vorbis and FLAC with minimp3, stb_vorbis and dr_flac, and
# fonts with the FreeType that SDL2_ttf's tarball includes.  The alternative is
# a dozen codec libraries from 18.04 bundled into the AppImage, each as old as
# the SDL this replaces.  HarfBuzz is left out: the game draws fixed-width text,
# which needs no shaping.
#
# Opus is the exception, because SDL_mixer has no decoder of its own for it and
# the Tk front end's music player offers it (lib/tcl/music.tcl).  So libogg,
# libopus and opusfile are built here too, as static archives, and linked into
# SDL2_mixer itself: still nothing beside it in the AppImage.
#
# SDL2 itself loads X11, OpenGL, ALSA, PulseAudio and the rest from the player's
# system at run time, as a distribution's SDL does, so none of that is bundled.
# Wayland is off, because SDL 2.32 wants libwayland 1.18 and 18.04 has 1.16; SDL2
# prefers X11 wherever both are available, so that costs nothing unless a
# player sets SDL_VIDEODRIVER=wayland.
#
# The tarballs are checked against the SHA-256 recorded here before anything is
# unpacked.  To move to a new release, change the URL and the checksum
# together; the cache key in the workflows is a hash of this file, so that is
# also what makes CI build it again.
set -o errexit

SDL=https://github.com/libsdl-org
XIPH=https://github.com/xiph

SDL2_URL=$SDL/SDL/releases/download/release-2.32.10/SDL2-2.32.10.tar.gz
SDL2_SHA256=5f5993c530f084535c65a6879e9b26ad441169b3e25d789d83287040a9ca5165
SDL2_IMAGE_URL=$SDL/SDL_image/releases/download/release-2.8.12/SDL2_image-2.8.12.tar.gz
SDL2_IMAGE_SHA256=393f5efb50536ec13ca4f4affb69cc9966d3c3f969e6c5e701faddf9f9785381
SDL2_TTF_URL=$SDL/SDL_ttf/releases/download/release-2.24.0/SDL2_ttf-2.24.0.tar.gz
SDL2_TTF_SHA256=0b2bf1e7b6568adbdbc9bb924643f79d9dedafe061fa1ed687d1d9ac4e453bfd
SDL2_MIXER_URL=$SDL/SDL_mixer/releases/download/release-2.8.2/SDL2_mixer-2.8.2.tar.gz
SDL2_MIXER_SHA256=938dff531d00ace2296557a6599abe6f34599e2f34f0a4a08a397e2ccac8b8f7

# The same checksums as Xiph's own SHA256SUMS on downloads.xiph.org.
OGG_URL=$XIPH/ogg/releases/download/v1.3.6/libogg-1.3.6.tar.gz
OGG_SHA256=83e6704730683d004d20e21b8f7f55dcb3383cdf84c0daedf30bde175f774638
OPUS_URL=$XIPH/opus/releases/download/v1.5.2/opus-1.5.2.tar.gz
OPUS_SHA256=65c1d2f78b9f2fb20082c38cbe47c951ad5839345876e46941612ee87f9a7ce1
OPUSFILE_URL=$XIPH/opusfile/releases/download/v0.12/opusfile-0.12.tar.gz
OPUSFILE_SHA256=118d8601c12dd6a44f52423e68ca9083cc9f2bfe72da7a8c1acb22a80ae3550b

ROOT=$(cd "$(dirname "$0")/.." && pwd)
PREFIX=${1:-$ROOT/sdl2/local}
WORK=$ROOT/sdl2
JOBS=$(nproc 2>/dev/null || echo 4)

# Which platform, asked once.  MSYS2's MINGW64 shell says MINGW64_NT-10.0 and
# builds PE DLLs; everything else here is ELF.  The two differ in three places
# and nowhere else: what a shared library is called, how its dependencies are
# read out of it, and which video driver SDL2 must have found.
case $(uname -s) in
MINGW*|MSYS*)
	WINDOWS=yes
	SHLIB_GLOB=$PREFIX/bin/SDL2*.dll
	WANT_VIDEO='windows'
	;;
*)
	WINDOWS=no
	SHLIB_GLOB=$PREFIX/lib/libSDL2*.so
	WANT_VIDEO='x11'
	;;
esac

# The libraries a shared object must not reach for.  On Linux they would have
# to go in the AppImage; on Windows beside the executable, and the first four
# are the ones MSYS2's rebuilt SDL2_mixer brought with it.  fluidsynth is named
# because it is the one that drags in GNU readline, and gme and modplug because
# they are the other two routes into a codec library SDL_mixer can do without.
FORBIDDEN='png|jpeg|webp|tiff|vorbis|ogg|opus|FLAC|mpg123|xmp|wavpack|fluidsynth|gme|modplug|freetype|harfbuzz|stdc\+\+'

# dependencies_of <shared library>: what it asks the loader for, one a line.
dependencies_of() {
	if [ "$WINDOWS" = yes ]; then
		objdump -p "$1" | sed -n 's/^[[:space:]]*DLL Name: //p'
	else
		objdump -p "$1" | awk '$1 == "NEEDED" { print $2 }'
	fi
}

# Each library finds the ones before it through pkg-config, and the satellites
# find SDL2 through sdl2-config as well; both have to answer with what was
# built here, not anything the system has.
PKG_CONFIG_PATH=$PREFIX/lib/pkgconfig
PATH=$PREFIX/bin:$PATH
export PKG_CONFIG_PATH PATH

# fetch <url> <sha256>: download once, check, and unpack afresh into sdl2/src.
fetch() {
	tarball=$WORK/download/$(basename "$1")
	if [ ! -f "$tarball" ]; then
		mkdir -p "$WORK/download"
		curl -fsSL -o "$tarball.part" "$1"
		mv "$tarball.part" "$tarball"
	fi
	echo "$2  $tarball" | sha256sum -c - >/dev/null || {
		echo "$tarball does not match the checksum in $0." >&2
		exit 1
	}
	mkdir -p "$WORK/src"
	rm -rf "$WORK/src/$(basename "$1" .tar.gz)"
	tar -xzf "$tarball" -C "$WORK/src"
}

# build <url> [configure arguments...]: out of tree, in sdl2/build.
build() {
	name=$(basename "$1" .tar.gz)
	shift
	echo "==> $name -> $PREFIX"
	rm -rf "$WORK/build/$name"
	mkdir -p "$WORK/build/$name"
	cd "$WORK/build/$name"
	"$WORK/src/$name/configure" --prefix="$PREFIX" "$@" >configure.log
	make -j"$JOBS" >make.log
	make install >install.log
}

# SDL2_image and SDL2_ttf only where the SDL2 front end is built; see the
# header.  The loop stays in this shell, so a checksum failure in fetch() ends
# the script rather than a subshell.
if [ "$WINDOWS" = yes ]; then
	set -- "$OGG_URL $OGG_SHA256" "$OPUS_URL $OPUS_SHA256" \
		"$OPUSFILE_URL $OPUSFILE_SHA256" "$SDL2_URL $SDL2_SHA256" \
		"$SDL2_MIXER_URL $SDL2_MIXER_SHA256"
else
	set -- "$OGG_URL $OGG_SHA256" "$OPUS_URL $OPUS_SHA256" \
		"$OPUSFILE_URL $OPUSFILE_SHA256" "$SDL2_URL $SDL2_SHA256" \
		"$SDL2_IMAGE_URL $SDL2_IMAGE_SHA256" "$SDL2_TTF_URL $SDL2_TTF_SHA256" \
		"$SDL2_MIXER_URL $SDL2_MIXER_SHA256"
fi
for pair in "$@"; do
	# shellcheck disable=SC2086
	fetch $pair
done

# Static, and position independent so that they can go inside a shared
# library.  opusfile's HTTP support would want OpenSSL, for streams nobody
# plays here.
STATIC='--enable-static --disable-shared --with-pic'
# shellcheck disable=SC2086
build "$OGG_URL" $STATIC
# shellcheck disable=SC2086
build "$OPUS_URL" $STATIC --disable-doc --disable-extra-programs
# shellcheck disable=SC2086
build "$OPUSFILE_URL" $STATIC --disable-http --disable-examples --disable-doc

# Wayland is a Linux question; MSYS2's SDL2 configure has no such option and
# would stop at an unrecognised one.
if [ "$WINDOWS" = yes ]; then
	build "$SDL2_URL" --disable-static
else
	build "$SDL2_URL" --disable-static --disable-video-wayland

	build "$SDL2_IMAGE_URL" --disable-static --enable-stb-image \
		--disable-avif --disable-jxl --disable-tif --disable-webp

	build "$SDL2_TTF_URL" --disable-static --enable-freetype-builtin \
		--disable-harfbuzz
fi

# pkg-config --static, so that opusfile brings libopus and libogg with it:
# their .pc files list them as private, which an ordinary query leaves out,
# and a shared SDL2_mixer linked without them would build, and then fail to
# load anywhere for want of opus_decode.
PKG_CONFIG='pkg-config --static' build "$SDL2_MIXER_URL" --disable-static \
	--enable-music-mp3-minimp3 --disable-music-mp3-mpg123 \
	--enable-music-ogg-stb --disable-music-ogg-vorbis --disable-music-ogg-tremor \
	--enable-music-flac-drflac --disable-music-flac-libflac \
	--enable-music-opus --disable-music-opus-shared \
	--disable-music-mod --disable-music-midi \
	--disable-music-gme --disable-music-wavpack

# Prove the result is what this script says it is, rather than trusting that a
# green build means it: the right versions are what pkg-config finds; none of
# the libraries reaches for a codec library the download would have to carry;
# Opus and MP3 are inside SDL2_mixer, not merely promised by it; and SDL2 has
# the video driver that opens a window.
echo "==> Checking the result"
MODULES='sdl2 SDL2_mixer'
[ "$WINDOWS" = no ] && MODULES='sdl2 SDL2_image SDL2_ttf SDL2_mixer'
for m in $MODULES; do
	printf '%-11s %s\n' "$m" "$(pkg-config --modversion $m)"
done
for lib in $SHLIB_GLOB; do
	if dependencies_of "$lib" | grep -E "$FORBIDDEN"; then
		echo "$lib links a library the download would have to carry." >&2
		exit 1
	fi
done

MIXER_BUILD=$WORK/build/$(basename "$SDL2_MIXER_URL" .tar.gz)
if ! grep -q -- '-DMUSIC_OPUS' "$MIXER_BUILD/Makefile"; then
	echo "SDL2_mixer was configured without Opus." >&2
	exit 1
fi
# MP3 is the one format the game cannot do without: every sound in lib/sounds
# is an MP3, and the Tk front end's music player offers it first.  minimp3 is
# the decoder, chosen because it is inside SDL_mixer's own tarball
# (src/codecs/minimp3) and is public domain, so it adds neither a DLL to carry
# nor a licence to honour.  mpg123 would be a second file in the download and
# SMPEG is long dead.
#
# Checked twice, because `--enable-music-mp3-minimp3` on a configure that did
# not know the option would be accepted silently and decode nothing.  First
# that it was compiled in at all:
if ! grep -q -- '-DMUSIC_MP3_MINIMP3' "$MIXER_BUILD/Makefile"; then
	echo "SDL2_mixer was configured without minimp3, so it decodes no MP3." >&2
	exit 1
fi
# And then a probe asks the built libraries themselves, rather than the build,
# the two things that matter most.
#
# Which video drivers SDL2 has.  SDL_GetVideoDriver lists every one compiled
# in without starting video, so it needs no display.  SDL2's configure summary
# cannot answer this: on Windows it lists the Direct3D renderers and never the
# windows driver itself, so a check that read it failed on a good build.
#
# Whether SDL2_mixer registers minimp3, under the name
# src/codecs/music_minimp3.c gives it, "MINIMP3".  Mix_OpenAudio registers
# only the two decoders that need no setting up, CMD and WAVE.  MP3 is
# registered by Mix_Init(MIX_INIT_MP3), or by the first MP3 loaded, which is how
# the game gets it: snd-sdl.c never calls Mix_Init.  A probe that left it out
# saw CMD and WAVE on a good build, so this one calls it.  The dummy audio
# driver means it needs no sound card, which no CI runner has.
#
# What it proves: the windows or X11 driver is compiled in, and so is the
# decoder, registered under its own name.  What it does not prove: that a
# window opens or that an MP3 plays.  Nothing here opens a display, decodes a
# file or listens to the result.
#
# main takes argc and argv because on Windows SDL.h renames it
# SDL_main(int, char **), and SDL2main supplies the real one; main(void) would
# not compile there.  gcc rather than cc, because MSYS2 may not provide cc.
cat >"$WORK/probe.c" <<'PROBE'
#include <stdio.h>
#include <string.h>
#include "SDL.h"
#include "SDL_mixer.h"

/* The one argument is the video driver SDL2 must have. */
int main(int argc, char *argv[])
{
	int i, n, video = 0, mp3 = 0;

	if (argc != 2) {
		fprintf(stderr, "usage: probe <video driver>\n");
		return 2;
	}

	printf("video drivers  ");
	n = SDL_GetNumVideoDrivers();
	for (i = 0; i < n; i++) {
		const char *d = SDL_GetVideoDriver(i);

		printf("%s%s", i ? " " : "", d);
		if (!strcmp(d, argv[1])) video = 1;
	}
	printf("\n");

	SDL_setenv("SDL_AUDIODRIVER", "dummy", 1);
	if (SDL_Init(SDL_INIT_AUDIO) != 0) {
		fprintf(stderr, "SDL_Init: %s\n", SDL_GetError());
		return 2;
	}
	if (!(Mix_Init(MIX_INIT_MP3) & MIX_INIT_MP3)) {
		fflush(stdout);
		fprintf(stderr, "Mix_Init: %s\n", Mix_GetError());
	}
	if (Mix_OpenAudio(44100, MIX_DEFAULT_FORMAT, 2, 2048) != 0) {
		fprintf(stderr, "Mix_OpenAudio: %s\n", Mix_GetError());
		return 2;
	}
	printf("music decoders ");
	n = Mix_GetNumMusicDecoders();
	for (i = 0; i < n; i++) {
		const char *d = Mix_GetMusicDecoder(i);

		printf("%s%s", i ? " " : "", d);
		if (!strcmp(d, "MINIMP3")) mp3 = 1;
	}
	printf("\n");
	fflush(stdout);
	Mix_CloseAudio();
	Mix_Quit();
	SDL_Quit();

	if (!video)
		fprintf(stderr, "SDL2 has no %s video driver, so it could open no window.\n",
			argv[1]);
	if (!mp3)
		fprintf(stderr, "SDL2_mixer registers no MINIMP3 decoder, so it decodes no MP3.\n");
	return video && mp3 ? 0 : 1;
}
PROBE
# shellcheck disable=SC2046
gcc "$WORK/probe.c" -o "$WORK/probe" $(pkg-config --cflags --libs SDL2_mixer sdl2)
PATH=$PREFIX/bin:$PATH LD_LIBRARY_PATH=$PREFIX/lib "$WORK/probe" "$WANT_VIDEO" ||
	exit 1
# Opus is linked in from static archives, so nothing should be left undefined
# for a loader to find.  ELF only: on Windows the same question is answered by
# the import scan above, which fails on an opus or ogg DLL by name.
if [ "$WINDOWS" = no ]; then
	if nm -D --undefined-only "$PREFIX/lib/libSDL2_mixer.so" |
			grep -E ' (op|opus|ogg)_'; then
		echo "SDL2_mixer leaves Opus symbols for something else to provide." >&2
		exit 1
	fi
fi

echo "==> Done.  Configure the game with PKG_CONFIG_PATH=$PREFIX/lib/pkgconfig"
