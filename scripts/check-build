#!/bin/sh
#
# Build the way CI builds, and let the exit code say whether it worked.
#
# Three builds, the manual and three cheap checks, because CI runs all of them
# and none subsumes another.
#
#   1. The macOS job, which builds the game through src/Makefile.osx with
#      clang. Asks for -Wshadow, -Wwrite-strings, -Wmissing-prototypes,
#      -Wnested-externs and -Wunused-macros; compiles to c99.
#   2. The Linux -Werror jobs, in their CMake shape with clang here. Asks for
#      -pedantic; compiles to gnu99; and builds and runs the unit tests, which
#      Makefile.osx does not.
#   3. The same again with GCC, because the Linux runners use GCC and it sees
#      things clang does not -- `depth > 0 || depth > 0` is an error to GCC
#      and silent to clang.
#   4. The manual, which .github/workflows/pages.yaml publishes on every push
#      to master that touches docs/. A broken directive or a bad cross
#      reference is a build failure there and was invisible here.
#   5b. The build input lists, which linux.yaml runs as its own step and which
#      three consecutive pushes went red on.
#   5. The realm content check, which asks whether the spell data in
#      class.txt is still what the converter produces from realmmap.toml and
#      Zangband's own table. A spell keyed under a name the source table does
#      not have is emitted with its level, mana and failure and no effect at
#      all -- which looks exactly like a deliberate deferral. One shipped that
#      way (Sorcery's *Teleport*, 3.55.0) and was found by accident.
#   6. The msys2 ASAN/UBSAN job, reproduced: a Debug build with
#      -fsanitize=address -fsanitize=undefined and, deliberately, **none of
#      the frontend options this script passes elsewhere**. That last part is
#      the point. `game/saves` failed two Windows CI runs while every other
#      job was green, and it was not the sanitizers and not Windows: the
#      savefile corpus is staged into the test working directory, and that
#      staging hung off SUPPORT_TEST_FRONTEND, which linux.yaml passes and
#      msys2.yaml does not. This pass builds the way that job builds, which is
#      the only way to see it. The sanitizers come along for the ride and are
#      worth having on their own.
#
# A defect can pass any five of the six.
#
# What made this necessary: `make -f Makefile.osx` and `cmake -S . -B build`
# both default to permissive, and CI passes -Werror to both. A pointer of the
# wrong type reached master having been diagnosed by the same clang that sits
# on this machine -- the local build simply was not asking for the flag that
# makes it fatal. It is not a weaker compiler here. It is the same compiler,
# run more kindly.
#
# It is also why nothing below greps. Filtering build output for the word
# "error" is guesswork about a compiler's phrasing, and guessing wrong reports
# success: `grep -E " error "` does not match clang's `error:`, which is how
# two invented identifiers got through on the same day. The exit code is not a
# heuristic.
#
# Usage:
#   scripts/check-build            every build, the manual, and the realm data
#   scripts/check-build --tests    ...and run the unit tests after
#
# The sanitizer pass is the slow one and is incremental in build-asan, so the
# first run pays for it and later ones do not.
#   scripts/check-build --tests    ...and run the unit tests after

set -e

if [ ! -f CMakeLists.txt ]; then
	echo "check-build: run from the top of the tree" >&2
	exit 2
fi

JOBS=$(sysctl -n hw.activecpu 2>/dev/null || nproc 2>/dev/null || echo 4)

# Homebrew's GCC, kept beside the system clang rather than displacing it --
# the same arrangement as python3.13 and .venv-docs. `cc` stays clang, which
# is what the macOS build below wants and what CI's macOS job uses.
GCC=${GCC:-/opt/homebrew/bin/gcc-16}

# The manual's virtualenv, made by the recipe in docs/README.md. Gitignored,
# so present on a working tree and absent on a fresh clone.
SPHINX=${SPHINX:-.venv-docs/bin/sphinx-build}

LOG=$(mktemp -t check-build)
trap 'rm -f "$LOG"' EXIT

# Quiet while it works, and everything it said the moment it does not.
#
# A gate that hides the diagnostic is only half a gate: the first version of
# this script sent the build output to /dev/null, so a failure gave an exit
# code and no reason -- which is how the compiler ends up talking to nobody
# again, by a third route.
run() {
	if ! "$@" >"$LOG" 2>&1; then
		cat "$LOG" >&2
		exit 1
	fi
}

# --- the macOS job, verbatim -------------------------------------------
#
# OPT replaces the default -O2 rather than adding to it, which is what CI
# does and so is what this does.
echo "check-build: building the game (Makefile.osx, OPT=-Werror)"
run sh -c "cd src && env OPT=-Werror make -f Makefile.osx -j$JOBS"

# --- the Linux test job's configuration --------------------------------
#
# -Wvla because two of the CI jobs ask for it. -Wlogical-op goes to the GCC
# pass below, clang not having it.
echo "check-build: building the tests (CMake, -Werror)"
run cmake -S . -B build-strict -G Ninja \
	-DCMAKE_C_FLAGS="-Werror -Wvla" \
	-DSUPPORT_TEST_FRONTEND=ON
run cmake --build build-strict --parallel

# --- and the same again under GCC ---------------------------------------
#
# The Linux runners compile with GCC; everything above is clang. -Wvla and
# -Wlogical-op come from the two statistics jobs, which ask for them and do
# *not* pass -Werror -- so CI prints those warnings and builds on regardless.
# They are errors here. That is one step stricter than CI deliberately, and
# affordable because the tree is clean of both: a flag CI turns on to surface
# logic bugs is worth stopping for, where -Wshadow (which fires on a dozen
# places in the existing test suite that every CI job builds happily) is not.
if [ -x "$GCC" ]; then
	echo "check-build: building again with GCC ($($GCC -dumpversion))"
	run cmake -S . -B build-gcc -G Ninja \
		-DCMAKE_C_COMPILER="$GCC" \
		-DCMAKE_C_FLAGS="-Werror -Wvla -Wlogical-op" \
		-DSUPPORT_TEST_FRONTEND=ON
	run cmake --build build-gcc --parallel
else
	echo "check-build: no GCC at $GCC -- skipping the GCC pass" >&2
	echo "check-build:   brew install gcc, then re-run" >&2
	exit 3
fi

# --- and the manual ----------------------------------------------------
#
# -W, because the manual builds clean today and a warning here is a broken
# cross reference or a malformed directive -- the two things this pass exists
# to catch. -E to rebuild from scratch, so a stale doctree cannot carry a
# previous success over a present failure.
#
# Missing Sphinx is a failure and not a skip. This pass was added because the
# manual was reported as building when it had not been built at all: the
# command being run took sphinx-build from PATH, nothing ever put the
# virtualenv there, and "sphinx-build: command not found" was read as "Sphinx
# is not installed on this machine" rather than as "the wrong command". A pass
# that quietly does nothing when a tool is absent reproduces exactly that, so
# this one says what is missing and how to fix it, and stops.
if [ ! -x "$SPHINX" ]; then
	echo "check-build: no Sphinx at $SPHINX" >&2
	echo "check-build:   /usr/bin/python3 -m venv .venv-docs" >&2
	echo "check-build:   .venv-docs/bin/pip install -r docs/requirements.txt" >&2
	exit 4
fi

echo "check-build: building the manual ($SPHINX -W)"
run "$PWD/$SPHINX" -W -E -b html docs docs/_build/html

# --- and the realm content ----------------------------------------------
#
# Three things have to agree: every spell name in realmmap.toml against
# Zangband's own table, in both directions; and every realm block emitted into
# class.txt against what the converter produces for that class today.
#
# This is here rather than in a test because the failure it catches is silent
# in the game. A mis-keyed name yields a spell with a level, a mana cost, a
# failure rate and no effect -- it parses, it appears in the book, it casts,
# and it does nothing. `player/realm` catches the ones that carry no deferral
# note; this catches the mis-key itself, and a hand edit that drifted from the
# generator, before either can ship.
#
# The interpreter is chosen rather than assumed. The converter reads TOML with
# `tomllib`, which is 3.11 and later, and `python3` on this machine is 3.9 --
# so taking whatever is on PATH makes this pass die on an import and say
# nothing about the realms. Missing is a failure and not a skip, for the same
# reason the Sphinx pass says so: a pass that quietly does nothing is worse
# than no pass, because it reports success.
PYTHON=""
for candidate in ${ZCONV_PYTHON:-} python3.14 python3.13 python3.12 python3.11 python3; do
	[ -n "$candidate" ] || continue
	if command -v "$candidate" >/dev/null 2>&1 &&
			"$candidate" -c 'import tomllib' >/dev/null 2>&1; then
		PYTHON="$candidate"
		break
	fi
done

if [ -z "$PYTHON" ]; then
	echo "check-build: no Python with tomllib (3.11 or later) found" >&2
	echo "check-build:   tried python3.14 python3.13 python3.12 python3.11 python3" >&2
	echo "check-build:   set ZCONV_PYTHON to one, or brew install python@3.13" >&2
	exit 5
fi

echo "check-build: checking the realm content ($PYTHON zconv realms --check)"
run "$PYTHON" tools/zconv/zconv.py realms --check

# The borrowed monster tiles, which nothing was checking.
#
# `graf-ztk.prf` is generated: it gives each imported monster the picture of an
# Angband monster that resembles it, so the bestiary is not half ASCII in
# graphics mode.  Generated and then committed, which means it can go stale
# without anything saying so -- and it had.  Two monsters, `hobo` and `raving
# lunatic`, were dropped from the import in 77b340f50 for being Angband's own
# wearing Zangband names, and their tile lines sat in four prf files for weeks
# afterwards pointing at monsters that no longer exist.
#
# The script has had a `--check` mode for exactly this the whole time. Nothing
# ran it.  A check nobody runs is a check that does not exist, which is the same
# lesson as the two passes above and is why this one is here rather than in a
# note somewhere.
echo "check-build: checking the borrowed monster tiles (borrow-tiles.py --check)"
run "$PYTHON" scripts/tiles/borrow-tiles.py --check

# The build-input lists, which linux.yaml runs as its own step.
#
# This was a separate script you had to remember, and three pushes in a row
# went red on it: a new lib/gamedata file was not in the install list, so a
# packaged build would have shipped without it.  Nothing about that needs a
# compiler, it takes a fraction of a second, and CI treats it as a gate -- so
# it belongs in the gate.  The fourth time a local pass has been added because
# CI caught something it did not, and the answer has been the same every time:
# build the way CI builds.
echo "check-build: checking the build input lists (scripts/check-build-lists)"
run scripts/check-build-lists

if [ "$1" = "--tests" ]; then
	echo "check-build: running the unit tests"
	# LANG matters: the suite compares rendered text and the C locale mangles
	# some of the characters it contains.
	( cd build-strict && LANG=en_US.UTF-8 ninja alltests )
fi

# --- and the way the Windows CI job builds --------------------------------
#
# Configured to match .github/workflows/msys2.yaml's asan-ubsan-clang64 job as
# closely as one can off Windows: Debug, no interprocedural optimisation, the
# same sanitizer flags, and no -DSUPPORT_* of any kind. The missing options are
# not an oversight -- they are what this pass exists to reproduce.
#
# It runs the tests unconditionally rather than under --tests, because a
# sanitizer build that is never run tells you nothing: ASAN and UBSAN report at
# run time, and the configuration difference this caught only shows up when a
# test goes looking for its data.
echo "check-build: building and testing as msys2/asan-ubsan does (Debug, ASAN+UBSAN, no frontends)"
if [ ! -d build-asan ]; then
	mkdir build-asan
	( cd build-asan && run cmake -G Ninja \
		-DCMAKE_BUILD_TYPE=Debug \
		-DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
		-DCMAKE_C_FLAGS="-fsanitize=address -fsanitize=undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer -fno-lto -g" \
		.. )
fi
( cd build-asan && LANG=en_US.UTF-8 run ninja alltests )

echo "check-build: clean"
