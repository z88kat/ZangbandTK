#!/bin/sh
#
# Build the way CI builds, and let the exit code say whether it worked.
#
# Three builds and the manual, because CI runs all four and none of them
# subsumes another.
#
#   1. The macOS job, which builds the game through src/Makefile.osx with
#      clang. Asks for -Wshadow, -Wwrite-strings, -Wmissing-prototypes,
#      -Wnested-externs and -Wunused-macros; compiles to c99.
#   2. The Linux -Werror jobs, in their CMake shape with clang here. Asks for
#      -pedantic; compiles to gnu99; and builds and runs the unit tests, which
#      Makefile.osx does not.
#   3. The same again with GCC, because the Linux runners use GCC and it sees
#      things clang does not -- `depth > 0 || depth > 0` is an error to GCC
#      and silent to clang.
#   4. The manual, which .github/workflows/pages.yaml publishes on every push
#      to master that touches docs/. A broken directive or a bad cross
#      reference is a build failure there and was invisible here.
#
# A defect can pass any three of the four.
#
# What made this necessary: `make -f Makefile.osx` and `cmake -S . -B build`
# both default to permissive, and CI passes -Werror to both. A pointer of the
# wrong type reached master having been diagnosed by the same clang that sits
# on this machine -- the local build simply was not asking for the flag that
# makes it fatal. It is not a weaker compiler here. It is the same compiler,
# run more kindly.
#
# It is also why nothing below greps. Filtering build output for the word
# "error" is guesswork about a compiler's phrasing, and guessing wrong reports
# success: `grep -E " error "` does not match clang's `error:`, which is how
# two invented identifiers got through on the same day. The exit code is not a
# heuristic.
#
# Usage:
#   scripts/check-build            every build, strictly, and the manual
#   scripts/check-build --tests    ...and run the unit tests after

set -e

if [ ! -f CMakeLists.txt ]; then
	echo "check-build: run from the top of the tree" >&2
	exit 2
fi

JOBS=$(sysctl -n hw.activecpu 2>/dev/null || nproc 2>/dev/null || echo 4)

# Homebrew's GCC, kept beside the system clang rather than displacing it --
# the same arrangement as python3.13 and .venv-docs. `cc` stays clang, which
# is what the macOS build below wants and what CI's macOS job uses.
GCC=${GCC:-/opt/homebrew/bin/gcc-16}

# The manual's virtualenv, made by the recipe in docs/README.md. Gitignored,
# so present on a working tree and absent on a fresh clone.
SPHINX=${SPHINX:-.venv-docs/bin/sphinx-build}

LOG=$(mktemp -t check-build)
trap 'rm -f "$LOG"' EXIT

# Quiet while it works, and everything it said the moment it does not.
#
# A gate that hides the diagnostic is only half a gate: the first version of
# this script sent the build output to /dev/null, so a failure gave an exit
# code and no reason -- which is how the compiler ends up talking to nobody
# again, by a third route.
run() {
	if ! "$@" >"$LOG" 2>&1; then
		cat "$LOG" >&2
		exit 1
	fi
}

# --- the macOS job, verbatim -------------------------------------------
#
# OPT replaces the default -O2 rather than adding to it, which is what CI
# does and so is what this does.
echo "check-build: building the game (Makefile.osx, OPT=-Werror)"
run sh -c "cd src && env OPT=-Werror make -f Makefile.osx -j$JOBS"

# --- the Linux test job's configuration --------------------------------
#
# -Wvla because two of the CI jobs ask for it. -Wlogical-op goes to the GCC
# pass below, clang not having it.
echo "check-build: building the tests (CMake, -Werror)"
run cmake -S . -B build-strict -G Ninja \
	-DCMAKE_C_FLAGS="-Werror -Wvla" \
	-DSUPPORT_TEST_FRONTEND=ON
run cmake --build build-strict --parallel

# --- and the same again under GCC ---------------------------------------
#
# The Linux runners compile with GCC; everything above is clang. -Wvla and
# -Wlogical-op come from the two statistics jobs, which ask for them and do
# *not* pass -Werror -- so CI prints those warnings and builds on regardless.
# They are errors here. That is one step stricter than CI deliberately, and
# affordable because the tree is clean of both: a flag CI turns on to surface
# logic bugs is worth stopping for, where -Wshadow (which fires on a dozen
# places in the existing test suite that every CI job builds happily) is not.
if [ -x "$GCC" ]; then
	echo "check-build: building again with GCC ($($GCC -dumpversion))"
	run cmake -S . -B build-gcc -G Ninja \
		-DCMAKE_C_COMPILER="$GCC" \
		-DCMAKE_C_FLAGS="-Werror -Wvla -Wlogical-op" \
		-DSUPPORT_TEST_FRONTEND=ON
	run cmake --build build-gcc --parallel
else
	echo "check-build: no GCC at $GCC -- skipping the GCC pass" >&2
	echo "check-build:   brew install gcc, then re-run" >&2
	exit 3
fi

# --- and the manual ----------------------------------------------------
#
# -W, because the manual builds clean today and a warning here is a broken
# cross reference or a malformed directive -- the two things this pass exists
# to catch. -E to rebuild from scratch, so a stale doctree cannot carry a
# previous success over a present failure.
#
# Missing Sphinx is a failure and not a skip. This pass was added because the
# manual was reported as building when it had not been built at all: the
# command being run took sphinx-build from PATH, nothing ever put the
# virtualenv there, and "sphinx-build: command not found" was read as "Sphinx
# is not installed on this machine" rather than as "the wrong command". A pass
# that quietly does nothing when a tool is absent reproduces exactly that, so
# this one says what is missing and how to fix it, and stops.
if [ ! -x "$SPHINX" ]; then
	echo "check-build: no Sphinx at $SPHINX" >&2
	echo "check-build:   /usr/bin/python3 -m venv .venv-docs" >&2
	echo "check-build:   .venv-docs/bin/pip install -r docs/requirements.txt" >&2
	exit 4
fi

echo "check-build: building the manual ($SPHINX -W)"
run "$PWD/$SPHINX" -W -E -b html docs docs/_build/html

if [ "$1" = "--tests" ]; then
	echo "check-build: running the unit tests"
	# LANG matters: the suite compares rendered text and the C locale mangles
	# some of the characters it contains.
	( cd build-strict && LANG=en_US.UTF-8 ninja alltests )
fi

echo "check-build: clean"
